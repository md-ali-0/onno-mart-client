# API origin used by both server components and the browser bundle.
# Local dev:  http://localhost:5000
# Production: the deployed API URL, e.g. https://onnomart-api.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# Signs the encrypted session cookie (jose). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=GENERATE_A_LONG_RANDOM_STRING
