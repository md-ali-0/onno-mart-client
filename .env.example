# API origin used by server components and the browser bundle.
# Local dev:  http://localhost:5000 while running onno-mart-server
# Production: https://onnomart-api.vercel.app
# Inlined at build time, so it must be present before `next build`.
NEXT_PUBLIC_BASE_URL=https://onnomart-api.vercel.app

# Public origin of this app. Drives canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://onno-mart.vercel.app

# Signs the encrypted session cookie (jose). Server-side only.
AUTH_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Guards POST /api/revalidate?tag=products&secret=... — server-side only.
REVALIDATE_SECRET=GENERATE_A_LONG_RANDOM_STRING