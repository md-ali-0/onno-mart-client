{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-preview2/types/**/*.ts",
    ".next-preview3/types/**/*.ts",
    ".next-blue/types/**/*.ts",
    ".next-blue2/types/**/*.ts",
    ".next-blue3/types/**/*.ts",
    ".next-blue4/types/**/*.ts",
    ".next-blue5/types/**/*.ts",
    ".next-lux/types/**/*.ts",
    ".next-lux2/types/**/*.ts",
    ".next-lux3/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
